# Copy to ~/.config/grokcode/agent.env and fill in locally. Do not commit the copy.
# The agent loads this file on its own. A real environment variable overrides a line here.
# Generate a token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

GROKCODE_MACHINE_NAME=laptop
GROKCODE_RELAY_URL=wss://YOUR_WORKER.workers.dev/agent
GROKCODE_MACHINE_TOKEN=replace-with-the-token-for-this-machine
# Optional direct/Tailscale listener. Omit both lines to use only the relay.
# GROKCODE_LISTEN=127.0.0.1:8788
# GROKCODE_MCP_TOKEN=replace-with-direct-mcp-token

# Password for the local `opencode serve` process. Username is always "opencode".
OPENCODE_PASSWORD=replace-with-opencode-password

# Used when start_session / send_prompt omit model. Also visible from server_info.
# GROKCODE_DEFAULT_MODEL=opencode-go/deepseek-v4.1-flash

# auto (default): attach when the password works, otherwise start on another port.
# spawn: own the process, replacing a foreign server unless ON_FOREIGN=next-port.
# attach: never start or stop OpenCode.
# GROKCODE_OPENCODE_MODE=auto
# GROKCODE_OPENCODE_ON_FOREIGN=next-port

# Optional comma-separated absolute directories the agent may open.
# GROKCODE_ALLOW_DIRS=/home/you/src,/home/you/work
