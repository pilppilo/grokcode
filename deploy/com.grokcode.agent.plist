<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template. deploy/install-macos.sh rewrites YOUR_HOME and installs
  this to ~/Library/LaunchAgents. Tokens stay in ~/.config/grokcode/agent.env.
  The agent loads that file itself.

  launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.grokcode.agent.plist
  launchctl enable gui/$UID/com.grokcode.agent
  launchctl kickstart -k gui/$UID/com.grokcode.agent
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.grokcode.agent</string>
    <key>ProgramArguments</key>
    <array>
      <string>YOUR_HOME/.local/bin/grokcode-agent</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>YOUR_HOME</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>YOUR_HOME/.config/grokcode/agent.log</string>
    <key>StandardErrorPath</key>
    <string>YOUR_HOME/.config/grokcode/agent.err.log</string>
  </dict>
</plist>
