# User systemd unit. Install with deploy/install-linux.sh, or copy this file to
# ~/.config/systemd/user/ and point ~/.local/bin/grokcode-agent at the built CLI.
# The agent reads ~/.config/grokcode/agent.env itself. Do not put tokens here.
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now grokcode-agent
#   loginctl enable-linger "$USER"

[Unit]
Description=Grokcode agent (OpenCode bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/grokcode-agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
